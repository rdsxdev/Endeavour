# Backend environment configuration
# Copy to .env and fill in values. Do NOT commit .env.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://endeavour:endeavour@localhost:5432/endeavour

# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# RPC (Hardhat local or Sepolia)
RPC_URL=http://127.0.0.1:8545
RPC_TIMEOUT_SECONDS=20.0

# Contract
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CHAIN_ID=31337

# Indexer
INDEXER_ENABLED=true
INDEXER_POLL_SECONDS=12
INDEXER_MAX_BLOCK_SPAN=2000
CONFIRMATION_DEPTH=3

# CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Admin (optional, for server-side admin operations)
ADMIN_PRIVATE_KEY=
